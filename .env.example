# 复制为 .env 后填写。generate: cp .env.example .env
# 只有标注「必填」的项缺失会阻止启动，其余留空即用默认值。

# ---------------- 模型（必填） ----------------
MODEL_API_KEY=
MODEL_NAME=qwen3.8-27b
MODEL_BASE_URL=
MODEL_TEMPERATURE=0
MODEL_TIMEOUT=120
MODEL_MAX_RETRIES=2

# ---------------- MySQL（mysql 工具必填） ----------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CHARSET=utf8mb4

# ---------------- 阿里云百炼知识库（rag 工具必填） ----------------
ALI_ACCESS_KEY_ID=
ALI_ACCESS_KEY_SECRET=
WORKSPACE_ID=
QUERY_INDEX_ID=
UPLOAD_CATEGORY_ID=
BAILIAN_ENDPOINT=bailian.cn-beijing.aliyuncs.com
BAILIAN_PARSER=DASHSCOPE_DOCMIND

# ---------------- 会话状态持久化 ----------------
# redis / mongodb / file
CHECKPOINT_BACKEND=redis
REDIS_URL=redis://localhost:6379
MONGODB_URL=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=chat

# ---------------- 路径 ----------------
# 相对路径基于仓库根目录解析，支持 ~ 展开
WORK_DIR=.temp
CHECKPOINT_DIR=.temp/checkpoint
# 留空则交给 Selenium Manager 自动下载匹配的 chromedriver
CHROMEDRIVER_PATH=

# ---------------- 安全护栏 ----------------
# 危险操作（删表、rm -rf、往终端敲命令）在执行前要人工确认
GUARD_ENABLED=true
# interactive=终端 y/n 确认；deny=一律拒绝（评测/CI 用）；allow=一律放行（仅限本地批处理）
GUARD_APPROVER=interactive
# 每次判定的留痕，JSONL 一行一条
GUARD_AUDIT_LOG=.temp/audit.jsonl

# ---------------- 可观测性 ----------------
# 每次运行写一份 span 追踪到 TRACE_DIR，用 `uv run agent trace` 查看
TRACE_ENABLED=true
TRACE_DIR=.temp/traces
# 单价：元 / 百万 token。留 0 则只统计 token，不折算金额
MODEL_PRICE_INPUT=0
MODEL_PRICE_OUTPUT=0

# ---------------- 上下文预算 ----------------
# 模型单次请求的字符预算；<=0 关闭裁剪（只影响模型看到的内容，会话状态不变）
CONTEXT_MAX_CHARS=24000
CONTEXT_KEEP_LAST=12

# ---------------- 其他 ----------------
DEBUG=false
